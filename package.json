{
  "name": "prato-cheio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prato Cheio — conecta doadores de alimentos a ONGs. Projeto da disciplina Análise, Projeto e Desenvolvimento Ágil.",
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --watch src/server.js",
    "test": "vitest run",
    "db:migrar": "prisma migrate deploy",
    "db:nova-migration": "prisma migrate dev --name",
    "ong:criar": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning scripts/criar-ong.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.10.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.13"
  }
}
