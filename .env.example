# Copie este arquivo para .env e troque pelos dados do seu banco no Neon. Nunca coloque a senha real aqui.
# DATABASE_URL: conexão "pooled" (host com -pooler), usada pelo sistema.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# DATABASE_URL_UNPOOLED: conexão direta (mesmo host sem -pooler), usada pelas migrations do Prisma.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
