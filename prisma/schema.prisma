generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  doador
  ong
  coordenacao
}

// Situação da conta de ONG diante da coordenação da cidade (ADR 0006).
// Doador e coordenação nascem aprovados: a situação só governa o aceite da ONG.
enum SituacaoDaConta {
  pendente
  aprovada
  recusada
}

// Ciclo de vida da doação. O aceite pode ser cancelado e a doação volta para
// disponivel; a retirada é o fim da linha (ADR 0008).
enum StatusDaDoacao {
  disponivel
  aceita
  retirada
}

model Usuario {
  id              Int             @id @default(autoincrement())
  nome            String
  email           String          @unique
  senha_hash      String
  papel           Papel
  estado          String
  cidade          String
  situacao        SituacaoDaConta @default(aprovada)
  avaliada_em     DateTime?
  avaliada_por_id Int?
  criado_em       DateTime        @default(now())

  avaliada_por     Usuario?  @relation("AvaliacoesDeConta", fields: [avaliada_por_id], references: [id], onDelete: SetNull)
  contas_avaliadas Usuario[] @relation("AvaliacoesDeConta")

  sessoes         Sessao[]
  doacoes_doadas  Doacao[] @relation("DoacoesPublicadas")
  doacoes_aceitas Doacao[] @relation("DoacoesAceitas")

  @@map("usuarios")
}

model Sessao {
  token      String   @id
  usuario_id Int
  expira_em  DateTime
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("sessoes")
}

model Doacao {
  id         Int    @id @default(autoincrement())
  tipo       String
  quantidade String
  validade   String

  // Onde a comida está. É cópia da localidade de quem publicou, feita no
  // instante da publicação, e não a localidade atual da conta: desde que a
  // conta pode mudar de cidade (ADR 0011), ler a cidade pela relação faria uma
  // doação antiga trocar de cidade junto com o doador.
  estado String
  cidade String

  status        StatusDaDoacao @default(disponivel)
  ong           String?
  criada_em     DateTime       @default(now())
  aceita_em     DateTime?
  retirada_em   DateTime?
  doador_id     Int
  ong_id        Int?
  publicada_por Usuario        @relation("DoacoesPublicadas", fields: [doador_id], references: [id])
  aceita_por    Usuario?       @relation("DoacoesAceitas", fields: [ong_id], references: [id])

  @@map("doacoes")
}
